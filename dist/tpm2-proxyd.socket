[Unit]
Description=tpm2-proxyd raw TPM access socket
Documentation=man:tpm2-proxyd(8)

[Socket]
# Downstream TCTI clients (tss2-tcti-proxy) connect here. The daemon picks this
# socket up via socket activation (sd_listen_fds).
ListenStream=/run/tpm2-proxyd/tpm2-proxyd.sock
# Every local user may connect: the daemon decides per connection, from the
# peer's credentials and its policy, which commands (if any) it forwards.
# Clients must not need the TPM device group (tss), whose members can open
# /dev/tpmrm0 directly and bypass the policy.
SocketMode=0666
SocketUser=tss
SocketGroup=tss
RemoveOnStop=true

[Install]
WantedBy=sockets.target
